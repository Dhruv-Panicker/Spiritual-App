# Copy this file to .env and fill in your values.
# Do not commit .env to version control.

# Supabase (publishable key — safe for client use; RLS enforces access)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Apps Script webhook (prayer email + live status relay)
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=

# Only needed for the one-time migration scripts in scripts/ (not bundled in the app)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEET_ID=
ADMIN_EMAILS=


PRAYER_RECIPIENT_EMAIL=

# Optional: Share / app links (defaults used if empty)
APP_NAME=Siddhguru
APP_STORE_LINK=https://apps.apple.com/app/siddhguru/id6761345708
PLAY_STORE_LINK=https://play.google.com/store/apps/details?id=com.spiritualwisdom
WEB_APP_LINK=https://spiritualwisdom.app
