{
  "expo": {
    "name": "Om Siddheshwar",
    "slug": "spiritual-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/gurudev-app-icon.png",
    "scheme": "guru-darshan",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/gurudev-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spiritualapp.gurudarshan",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Choose a photo to attach to your prayer submission."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gurudev-app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.spiritualapp.gurudarshan",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/gurudev-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      ["@sentry/react-native/expo", { "organization": "siddhguru", "project": "react-native" }],
      ["expo-notifications", { "icon": "./assets/images/gurudev-app-icon.png", "color": "#c17f3c", "defaultChannel": "default" }],
      ["expo-build-properties", { "android": { "compileSdkVersion": 36, "targetSdkVersion": 36, "buildToolsVersion": "36.0.0" } }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "eas": { "projectId": "0a61bbdb-728e-4e8e-8f64-74d6790183b0" }
    }
  }
}
